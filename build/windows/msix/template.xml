<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="d75-studio"
        Arguments=""
        InstallLocation="C:\Program Files\aguacate\D75 Studio">
    </Installer>
    <PackageInformation
        PackageName="D75 Studio"
        PackageDisplayName="D75 Studio"
        PublisherName="CN=aguacate"
        PublisherDisplayName="aguacate"
        Version="0.1.0.0"
        PackageDescription="Configurador del teclado Weikav D75">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.aguacate.d75studio"
                Description="Configurador del teclado Weikav D75"
                DisplayName="D75 Studio"
                ExecutableName="d75-studio"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>D75 Studio</DisplayName>
            <PublisherDisplayName>aguacate</PublisherDisplayName>
            <Description>Configurador del teclado Weikav D75</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="d75-studio.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
